# Default connects to the Go backend. Set demo for the standalone simulation.
VITE_GAME_MODE=backend
# Vite development proxy target (never put secrets in VITE_ variables).
BACKEND_URL=http://localhost:7000
# Production: leave blank with a same-origin reverse proxy, or set API + WS URLs.
VITE_API_BASE_URL=
VITE_WS_URL=
